<?php
declare(strict_types=1);
/** @var DanbooruImagesExtension $this */
$size = $this->getUserConfigurationValue('size', '720');
$proxy = (string)$this->getUserConfigurationValue('proxy', '');
?>
<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

	<div class="form-group">
		<label class="group-name" for="size">Image size</label>
		<div class="group-controls">
			<select name="size" id="size">
				<option value="720" <?= $size === '720' ? 'selected="selected"' : '' ?>>720px (always available)</option>
				<option value="sample" <?= $size === 'sample' ? 'selected="selected"' : '' ?>>Sample, 850px wide (missing on small originals)</option>
			</select>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="proxy">Proxy URL</label>
		<div class="group-controls">
			<input type="text" name="proxy" id="proxy" value="<?= htmlspecialchars($proxy, ENT_QUOTES, 'UTF-8') ?>" placeholder="leave empty to load directly" />
			<p class="help">Empty = load straight from cdn.donmai.us. Otherwise e.g. <code>http://localhost:8081/?url=</code></p>
		</div>
	</div>

	<div class="form-group form-actions">
		<div class="group-controls">
			<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
		</div>
	</div>
</form>
